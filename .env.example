PORT=3402
NODE_ENV=development
LOG_LEVEL=info

# LLM Provider: anthropic | openai | openclaw
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o
OPENCLAW_API_URL=http://localhost:3000
OPENCLAW_API_KEY=

# ClawAPIs — leave as placeholder to use simulation mode
CLAWAPIS_BASE_URL=https://api.clawapis.com
CLAWAPIS_API_KEY=your-clawapis-key

# Cache
REDIS_URL=
CACHE_TTL_SECONDS=300
CACHE_MAX_MEMORY_ITEMS=10000

# Revenue
MARKUP_PERCENT=15
TREASURY_WALLET=

# Auth & Rate Limiting (Phase 2)
API_KEYS=
RATE_LIMIT_PER_MIN=60

# Telegram (Phase 3)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=