PORT=3402
NODE_ENV=development
LOG_LEVEL=info

# LLM Provider: anthropic | openai | openclaw
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o
OPENCLAW_API_URL=http://localhost:3000
OPENCLAW_API_KEY=

# ClawAPIs — leave as placeholder to use simulation mode
CLAWAPIS_BASE_URL=https://api.clawapis.com
CLAWAPIS_API_KEY=your-clawapis-key

# Cache
REDIS_URL=
CACHE_TTL_SECONDS=300
CACHE_MAX_MEMORY_ITEMS=10000

# Revenue
MARKUP_PERCENT=15
TREASURY_WALLET=

# Auth & Rate Limiting (Phase 2)
API_KEYS=
RATE_LIMIT_PER_MIN=60

# Telegram (Phase 3)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Persistent storage — SQLite database path. Default matches the filename
# already in production (data/orchestrator.db) so runtime, backup, and
# restore naming stay aligned. Inside Docker this lands in the bind-mounted
# ./data volume so the database survives container rebuilds. Leave blank
# to accept the default.
DB_PATH=./data/orchestrator.db

# Credential vault (secret-at-rest) — 32 random bytes, base64-encoded
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Optional at this stage: when unset, vault-crypto falls back to plain
# base64 and logs a one-time warning. Set this before storing any
# sensitive secret through the vault wrapper.
CREDENTIAL_VAULT_KEK=

# Soma heart — ClawNet's root identity signing key (encrypted at rest)
# Required to start the server once heart init is active.
# Generate: openssl rand -base64 48
CLAWNET_HEART_SECRET=
# Optional override for heart state file path (default: data/clawnet-heart.json)
# CLAWNET_HEART_PATH=

# --- Lineage fork ceremony (run from child repo, not from ClawNet) ---
# ClawNet is the ROOT heart in the lineage tree. It does not carry lineage
# in its own blob, but it must exist as parent for the ceremony to sign the
# lineage cert for a child (e.g. Pulse).
#
# CLAWNET_HEART_SECRET is needed at ceremony time — not at normal runtime.
# The ceremony runs from the child repo using the soma-heart-fork CLI:
#
#   npx soma-heart-fork \
#     --parent-blob data/clawnet-heart.json \
#     --parent-secret-env CLAWNET_HEART_SECRET \
#     --child-blob <path/to/child-heart.json> \
#     --child-secret-env <CHILD_SECRET_ENV> \
#     --capabilities "cap1,cap2" \
#     --ttl 90d \
#     --output <path/to/patched-child.json>
#
# The parent blob (data/clawnet-heart.json) stays unchanged by the ceremony.
# Only the child blob is patched with the signed lineage certificate.