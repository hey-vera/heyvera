# Cortex Brain — Environment Variables
# Copy to .env and fill in values for your deployment.

# ─── Core ───
CORTEX_PORT=3001
RUST_LOG=info,cortex_api=info

# ─── Database ───
# Inside Docker this should point to the mounted volume.
# Default: /data/cortex.db (Docker), .cortex/cortex.db (local dev)
CORTEX_DB_PATH=/data/cortex.db

# ─── Auth (Clerk) ───
CLERK_SECRET_KEY=

# ─── LLM Providers ───
# At least one provider key is needed for the engine to route requests.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─── Worker Registration ───
# Shared secret workers use to authenticate with the Brain via WebSocket.
# Generate: openssl rand -hex 32
CORTEX_WORKER_SECRET=

# ─── Stripe (Direct) ───
# Stripe secret key and webhook signing secret.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe Price IDs (create in Stripe Dashboard → Products)
# STRIPE_PRICE_MONTHLY=price_...       # $7.99/mo recurring
# STRIPE_PRICE_ANNUAL=price_...        # $79/yr recurring
# STRIPE_PRICE_CREDIT_PACK=price_...   # $4.99 one-time, 100 credits
# STRIPE_SUCCESS_URL=https://cortex.heyvera.org/billing?success=true
# STRIPE_CANCEL_URL=https://cortex.heyvera.org/billing?cancelled=true
