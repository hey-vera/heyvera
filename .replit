modules = ["nodejs-20", "python-3.12", "web", "bash"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"

packages = ["tmux"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Backend API"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd dashboard && npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Backend API"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 3000

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3001

[userenv]

[userenv.shared]
PORT = "3000"
CLAWNET_HEART_SECRET = "6hbupbxZsWVakMmGXCea0DT/csz2SYFCb7+euit9qwoLR4o1a/NydgSOxsn8fveO"
CREDENTIAL_VAULT_KEK = "Yp5qIv6KPP85O+a7ejejMajtxOEDgdB1As2aXMlXmeo="
DB_PATH = "./data/orchestrator.db"
NODE_ENV = "development"
LOG_LEVEL = "info"
LLM_PROVIDER = "anthropic"
RATE_LIMIT_PER_MIN = "60"
CACHE_TTL_SECONDS = "300"
CACHE_MAX_MEMORY_ITEMS = "10000"
MARKUP_PERCENT = "15"
WEBAUTHN_RP_ID = "localhost"

[deployment]
deploymentTarget = "autoscale"
run = ["npm", "run", "start"]
build = ["bash", "-c", "cd dashboard && npm run build && npm run build --prefix .. 2>/dev/null || true"]
onBoot = "source /home/runner/workspace/.replit-tools/scripts/setup-claude-code.sh 2>/dev/null || true"
