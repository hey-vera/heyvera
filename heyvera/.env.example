# Clerk publishable key — required for auth features.
# Without this key the app runs in public read-only mode.
# Get your key from https://dashboard.clerk.com → API Keys.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Backend API base URL.
#
# --- Production ---
# When using the Cloudflare Pages /v1/* proxy (recommended): leave unset.
# The app defaults to relative /v1/social paths which the proxy handles.
#
# When the backend is on a separate origin:
#   VITE_API_URL=https://api.heyvera.org
#
# --- Local dev ---
# Leave unset — the Vite dev server proxies /v1 → localhost:3402 automatically.
#
# VITE_API_URL=https://api.heyvera.org
