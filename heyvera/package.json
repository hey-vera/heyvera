{
  "name": "heyvera-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test:unit": "vitest run",
    "test:e2e": "playwright test tests/e2e/",
    "test:visual": "playwright test tests/e2e/visual-regression.spec.ts",
    "test:responsive": "playwright test",
    "typecheck": "tsc -b --pretty false",
    "build": "tsc -b && vite build",
    "check": "npm run build",
    "proof": "node ./scripts/proof-packet.mjs",
    "status:update": "node ./scripts/update-status.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.9",
    "lucide-react": "^1.28.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.1.4",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
