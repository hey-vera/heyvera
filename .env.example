# ClawNet Orchestrator — Environment Variables
# This file tracks variables consumed by the codebase.
# The production VPS .env is the source of truth for actual values.
# When adding a new env var to source code, add it here too.

# ─── Core ───
PORT=3402
NODE_ENV=development
LOG_LEVEL=info

# ─── LLM Providers ───
# LLM_PROVIDER: anthropic | openai | openclaw
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o
OPENCLAW_API_URL=http://localhost:3000
OPENCLAW_API_KEY=

# ─── Cache ───
REDIS_URL=
CACHE_TTL_SECONDS=300
CACHE_MAX_MEMORY_ITEMS=10000

# ─── Auth & Rate Limiting ───
API_KEYS=
ADMIN_API_KEY=
RATE_LIMIT_PER_MIN=60

# ─── Clerk Authentication ───
CLERK_SECRET_KEY=

# ─── Database ───
# Path to the SQLite database file. Default matches the filename already in
# production (data/orchestrator.db). Inside Docker this lands in the
# bind-mounted ./data volume so the database survives container rebuilds.
DB_PATH=./data/orchestrator.db

# ─── Credential Vault ───
# Base64-encoded 32-byte key-encryption-key for AES-256-GCM secret wrapping.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Optional: when unset, vault falls back to plain base64 (functional but not
# encrypted at rest).
CREDENTIAL_VAULT_KEK=

# ─── Soma Heart ───
# ClawNet's root identity signing key (encrypted at rest with scrypt + XSalsa20).
# Generate: openssl rand -base64 48
CLAWNET_HEART_SECRET=
# Optional override for heart state file path (default: data/clawnet-heart.json)
# CLAWNET_HEART_PATH=

# ─── WebAuthn Ceremony ───
# Set to production domain/origin on VPS
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGIN=http://localhost:3402

# ─── Rotation Shadow-Check ───
# Set to any non-empty string to enable the read-only shadow-check
# middleware. Leave empty or unset to disable.
ROTATION_SHADOW_CHECK_ENABLED=

# ─── Telegram ───
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# ─── Revenue ───
MARKUP_PERCENT=15
TREASURY_WALLET=
