PORT=3402
NODE_ENV=development
LOG_LEVEL=info

# ─── LLM Provider ────────────────────────────────────────────────────────────
# Options: anthropic | openai | openclaw
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_INTENT_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o
OPENAI_INTENT_MODEL=gpt-4o-mini
OPENCLAW_API_URL=http://localhost:3000
OPENCLAW_API_KEY=

# ─── ClawAPIs (data source) ──────────────────────────────────────────────────
CLAWAPIS_BASE_URL=https://clawapis.com

# ─── Cache ────────────────────────────────────────────────────────────────────
REDIS_URL=
REDIS_PASSWORD=
CACHE_TTL_SECONDS=300
CACHE_MAX_MEMORY_ITEMS=10000

# ─── Revenue & Pricing ───────────────────────────────────────────────────────
MARKUP_PERCENT=15
CREDITS_PER_USD=1000
TREASURY_WALLET=
# Per-query orchestration fee (credits) — covers LLM cost, pure profit
# ORCHESTRATION_FEE=2

# ─── Auth & Security ─────────────────────────────────────────────────────────
API_KEYS=
# ADMIN_API_KEY must be ≥16 chars in production — protects /v1/admin routes
ADMIN_API_KEY=
PLATFORM_SIGNING_SECRET=
CLERK_SECRET_KEY=
# Comma-separated Clerk user IDs allowed to resolve escrow disputes
ADMIN_CLERK_IDS=
# Comma-separated emails with admin dashboard access
ADMIN_EMAILS=

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_PER_MIN=60
FREE_TRIAL_CREDITS=0
DAILY_SPEND_CAP=0
ANOMALY_THRESHOLD=5000

# ─── Referrals ───────────────────────────────────────────────────────────────
REFERRAL_BONUS_RECEIVER=500
REFERRAL_BONUS_OWNER=250

# ─── Stripe Payments ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUBSCRIPTION_WEBHOOK_SECRET=

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=

# ─── Telegram Notifications ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# ─── Solana ───────────────────────────────────────────────────────────────────
# SOLANA_PRIVATE_KEY enables real x402 API calls (simulation mode without it)
SOLANA_PRIVATE_KEY=
SOLANA_RECEIVING_WALLET=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_FALLBACK=

# ─── Payout System (Option A — Solana USDC cron) ─────────────────────────────
# Dedicated hot wallet private key (bs58) — NOT the same as SOLANA_PRIVATE_KEY
PLATFORM_PAYOUT_PRIVATE_KEY=
# Payout rate: 25% below buy rate to prevent arbitrage
PAYOUT_USDC_PER_CREDIT=0.00075

# ─── EVM / Base Chain ────────────────────────────────────────────────────────
# Private key for x402 auto-split payouts (97% to creator on Base)
EVM_PRIVATE_KEY=
BASE_RPC_URL=

# ─── x402 Consumer Mode ──────────────────────────────────────────────────────
X402_X_API_URL=https://clawapis.com

# ─── x402 Provider Mode (serve skills as x402 endpoints) ─────────────────────
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_NETWORK=base-mainnet
# Set this EVM address to enable x402 provider mode (receives USDC on Base)
X402_RECIPIENT_ADDRESS=
# Aligned with Stripe base rate ($0.001/credit)
X402_USDC_PER_CREDIT=0.001

# ─── Treasury Auto-Sweep ─────────────────────────────────────────────────────
TREASURY_SWEEP_WALLET=
TREASURY_SWEEP_MIN=10000
HOT_WALLET_LOW_BALANCE_USDC=50

# ─── Monitoring ───────────────────────────────────────────────────────────────
SENTRY_DSN=
ADMIN_EMAIL=
