### D. Formal Definitions

#### D.1 ABNF Headers (RFC 5234)

```abnf
; AID Request Headers (RFC 5234 ABNF)

X-AID-DID           = "X-AID-DID" ":" SP did-key
X-AID-PROOF         = "X-AID-PROOF" ":" SP base64url
X-AID-TIMESTAMP     = "X-AID-TIMESTAMP" ":" SP iso8601-utc
X-AID-NONCE         = "X-AID-NONCE" ":" SP 32HEXDIG
X-AID-TRUST-SCORE   = "X-AID-TRUST-SCORE" ":" SP 1*3DIGIT
X-AID-VERSION       = "X-AID-VERSION" ":" SP version-string
X-AID-NEW           = "X-AID-NEW" ":" SP 1*64agent-char

; AID Response Headers
X-AID-PROVIDER-DID   = "X-AID-PROVIDER-DID" ":" SP did-key
X-AID-PROVIDER-PROOF = "X-AID-PROVIDER-PROOF" ":" SP base64url
X-AID-RECEIPT        = "X-AID-RECEIPT" ":" SP base64url
X-AID-FEEDBACK-URL   = "X-AID-FEEDBACK-URL" ":" SP relative-uri
X-AID-TRUST-VERIFIED = "X-AID-TRUST-VERIFIED" ":" SP 1*3DIGIT

; 402 Response Headers
X-AID-TRUST-GATE     = "X-AID-TRUST-GATE" ":" SP trust-gate-params
X-AID-PRICING-TIERS  = "X-AID-PRICING-TIERS" ":" SP pricing-json

; Primitives
did-key          = "did:key:" multibase-ed25519
multibase-ed25519 = "z" 1*48base58btc-char
base58btc-char   = DIGIT / %x41-48 / %x4A-4E / %x50-5A  ; 1-9, A-H, J-N, P-Z
                 / %x61-6B / %x6D-7A                      ; a-k, m-z (no 0, O, I, l)
base64url        = 1*base64url-char
base64url-char   = ALPHA / DIGIT / "-" / "_"
iso8601-utc      = 4DIGIT "-" 2DIGIT "-" 2DIGIT "T"
                   2DIGIT ":" 2DIGIT ":" 2DIGIT "Z"
version-string   = 1*DIGIT "." 1*DIGIT
agent-char       = ALPHA / DIGIT / "-" / "_"
trust-gate-params = "min_score=" 1*3DIGIT "," "tier=" token
pricing-json     = %x5B *OCTET %x5D  ; JSON array (validated at application layer)
relative-uri     = "/" *( pchar / "/" / "?" )
pchar            = unreserved / pct-encoded / sub-delims / ":" / "@"
unreserved       = ALPHA / DIGIT / "-" / "." / "_" / "~"
pct-encoded      = "%" HEXDIG HEXDIG
sub-delims       = "!" / "$" / "&" / "'" / "(" / ")" / "*" / "+" / "," / ";" / "="
token            = 1*tchar
tchar            = "!" / "#" / "$" / "%" / "&" / "'" / "*" / "+" / "-" / "." /
                   "^" / "_" / "`" / "|" / "~" / DIGIT / ALPHA
```

