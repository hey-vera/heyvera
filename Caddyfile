# ClawNet — Caddy reverse proxy config
# Deploy to /etc/caddy/Caddyfile on guardian-vps
#
# Static site:  /var/www/claw-net/ (clean URLs, no .html extensions)
# API:          localhost:3402 (Hono, Docker)
# Dashboard:    /var/www/claw-net-dashboard/ (Soma Signing Authority SPA)
# HeyVera app:  /home/guardian/www/heyvera/ (React SPA)

heyvera.org, www.heyvera.org {
	handle /v1/* {
		reverse_proxy localhost:3402
	}

	handle /assets/* {
		root * /home/guardian/www/heyvera
		file_server
		header Cache-Control "public, max-age=31536000, immutable"
	}

	handle {
		root * /home/guardian/www/heyvera
		try_files {path} /index.html
		file_server
		header Cache-Control "no-cache, no-store, must-revalidate"
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
}

cortex.heyvera.org {
	# API routes - MUST be first for priority
	@api path /api/* /v1/*
	handle @api {
		reverse_proxy localhost:3001 {
			header_up Host {upstream_hostport}
			header_up X-Real-IP {remote}
			header_up X-Forwarded-For {remote}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Static assets with caching
	@assets path /assets/*
	handle @assets {
		root * /var/www/cortex
		file_server
		header Cache-Control "public, max-age=31536000, immutable"
	}

	# SPA fallback for all other requests
	handle {
		root * /var/www/cortex
		try_files {path} /index.html
		file_server
		header Cache-Control "no-cache, no-store, must-revalidate"
	}

	# Security headers
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
}

api.heyvera.org {
	# Cortex product API
	handle /api/* {
		reverse_proxy localhost:3001 {
			header_up Host {upstream_hostport}
			header_up X-Real-IP {remote}
			header_up X-Forwarded-For {remote}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# HeyVera Social + Pulse + health — single owner: heyvera-server :3002
	handle /v1/social/* {
		reverse_proxy localhost:3002 {
			header_up Host {upstream_hostport}
			header_up X-Real-IP {remote}
			header_up X-Forwarded-For {remote}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle /v1/pulse/* {
		reverse_proxy localhost:3002 {
			header_up Host {upstream_hostport}
			header_up X-Real-IP {remote}
			header_up X-Forwarded-For {remote}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle /v1/health {
		reverse_proxy localhost:3002 {
			header_up Host {upstream_hostport}
			header_up X-Real-IP {remote}
			header_up X-Forwarded-For {remote}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle /v1/ready {
		reverse_proxy localhost:3002 {
			header_up Host {upstream_hostport}
			header_up X-Real-IP {remote}
			header_up X-Forwarded-For {remote}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Remaining v1 endpoints → legacy Node product API (if still needed)
	handle /v1/* {
		reverse_proxy localhost:3402 {
			header_up Host {upstream_hostport}
			header_up X-Real-IP {remote}
			header_up X-Forwarded-For {remote}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle {
		respond "Not found" 404
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
}

api.claw-net.org {
	reverse_proxy localhost:3402
}

pulse.claw-net.org {
	reverse_proxy localhost:3457
}

radar.claw-net.org {
	reverse_proxy localhost:3459
}

claw-net.org, www.claw-net.org {
	# Static site — clean URLs
	root * /var/www/claw-net

	# Dashboard SPA — serve built Vite app as static files
	# All /dashboard/* paths serve from the dashboard dist dir
	# with SPA fallback (all sub-routes serve index.html)
	handle_path /dashboard/* {
		root * /var/www/claw-net-dashboard
		try_files {path} /index.html
		file_server
	}
	# Bare /dashboard redirects to /dashboard/
	redir /dashboard /dashboard/ 308

	# ADDITION: Proxy /api/* to API server so dashboard API
	# calls work from same origin (dashboard uses relative URLs
	# like /api/authn/register/options)
	handle /api/* {
		reverse_proxy localhost:3402
	}

	# Portal — also proxy to API (legacy path)
	route /portal* {
		reverse_proxy localhost:3402
	}

	# Clean URL rewrite: /endpoints → endpoints.html
	try_files {path} {path}.html {path}/index.html

	file_server

	# API reverse proxy — all /v1/*, /x402/*, /mcp/*, /health, etc.
	handle /v1/* {
		reverse_proxy localhost:3402
	}
	handle /x402/* {
		reverse_proxy localhost:3402
	}
	handle /mcp/* {
		reverse_proxy localhost:3402
	}
	handle /health {
		reverse_proxy localhost:3402
	}
	handle /.well-known/* {
		reverse_proxy localhost:3402
	}
	handle /a2a/* {
		reverse_proxy localhost:3402
	}
	handle /feed.xml {
		reverse_proxy localhost:3402
	}
	handle /health/* {
		reverse_proxy localhost:3402
	}
	handle /llms.txt {
		reverse_proxy localhost:3402
	}
	handle /llms.txt/* {
		reverse_proxy localhost:3402
	}

	# Security headers
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
}
