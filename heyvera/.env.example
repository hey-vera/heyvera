# Clerk publishable key — required for auth features.
# Without this key the app runs in public read-only mode.
# Get your key from https://dashboard.clerk.com → API Keys.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Backend API base URL.
#
# --- Production builds ---
# Prefer absolute API origin so SPA calls go to the Social/Pulse owner:
#   VITE_API_URL=https://api.heyvera.org
# (api.heyvera.org routes /v1/social/* + /v1/pulse/* + health → heyvera-server :3002)
#
# Same-origin on heyvera.org also works after Caddy apex routes social/pulse → :3002
# and /api/* → :3001 — leave unset only when the apex reverse-proxy is deployed.
#
# --- Local dev ---
# Leave unset (empty). Vite proxies match production ownership:
#   /v1/social, /v1/pulse, /v1/health, /v1/ready → localhost:3002 (heyvera-server)
#   /api/*                                      → localhost:3001 (cortex-server)
#   remaining /v1/*                             → localhost:3402 (legacy)
#
# VITE_API_URL=https://api.heyvera.org
